{
  "name": "gestao-epi",
  "version": "2.4.0",
  "description": "Gestão EPI para Windows",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "37.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "br.com.gestao.epi",
    "productName": "Gestão EPI",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "app-icon.png",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Gestao-EPI-${version}.exe"
    }
  }
}
